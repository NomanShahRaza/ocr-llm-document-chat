PADDLEOCR_VL_VERSION=v1.6
PADDLEOCR_ENGINE=paddle
XIAOMI_OCR_MODEL=xiaomi-research/Xiaomi-OCR-0
PADDLEOCR_DEVICE=gpu:0
ENABLE_ORIENTATION=true
ENABLE_UNWARPING=true
MAX_UPLOAD_MB=100
BGE_M3_MODEL=BAAI/bge-m3
RAG_DEVICE=cpu
RAG_CHUNK_CHARS=900
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=8
RAG_RRF_K=60
RAG_AUTO_INDEX=true
# Answer LLM (OpenAI-compatible). Leave LLM_MODEL empty for the extractive fallback.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=120
LLM_MAX_TOKENS=700
LLM_TEMPERATURE=0.2
LLM_CONTEXT_HITS=8
LLM_HISTORY_TURNS=6
